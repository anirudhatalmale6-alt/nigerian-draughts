# naijadraftclub.com lives in this folder of the ehmar.com hosting account (alias domain).
# These rules replace the store's rules for this folder, so WordPress never answers here.
RewriteEngine On
# Only reachable through naijadraftclub.com (ehmar.com/naijadraftclub/ gives 404).
RewriteCond %{HTTP_HOST} !^(www\.)?naijadraftclub\.com$ [NC]
RewriteRule ^ - [R=404,L]
# One address: www goes to the bare domain.
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^(.*)$ http://naijadraftclub.com/$1 [L,R=301]
